# Environment Variables

# Database (SQLite by default — change to PostgreSQL for Neon/Supabase)
DATABASE_URL=file:../db/custom.db

# Session secret (change this in production!)
SESSION_SECRET=lifeos-dev-secret-change-in-production

# Optional: AI provider (leave empty to use built-in Z.AI SDK)
# AI_PROVIDER=openai-compatible
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
