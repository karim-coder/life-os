# Environment Variables

# Database (PostgreSQL)
# Local example: create a database named life_os in your local PostgreSQL server.
# Vercel example: use your Neon PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/life_os

# Session secret (change this in production!)
SESSION_SECRET=lifeos-dev-secret-change-in-production

# Optional: AI provider (leave empty to use built-in Z.AI SDK)
# AI_PROVIDER=openai-compatible
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
